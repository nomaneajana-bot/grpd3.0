{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["node"]
  },
  "include": [
    "api/**/*.ts",
    "app/api/**/*.ts",
    "lib/server/**/*.ts",
    "lib/phone-normalize.ts",
    "types/**/*.ts"
  ],
  "exclude": ["node_modules", "lib/server/__tests__"]
}

{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["node"]
  },
  "include": [
    "app/api/**/*.ts",
    "lib/server/**/*.ts",
    "api/v1/**/*.ts",
    "lib/phone-normalize.ts",
    "types/**/*.ts"
  ],
  "exclude": [
    "**/__tests__/**",
    "node_modules"
  ]
}

# --- Expo (copy to .env, restart with: npx expo start -c) ---

# === Isolated D02/D03 Test rehearsal (PIN + Preview) ===
# Do NOT commit real .env. Nouamane owns credential distribution.
# EXPO_PUBLIC_AUTH_MODE=pin
# EXPO_PUBLIC_API_URL=https://grpd30-355kzkwzz-noas-projects-0b3f311d.vercel.app
# EXPO_PUBLIC_VERCEL_BYPASS=<automation bypass for protected Preview; Test only>
# Leave EXPO_PUBLIC_SUPABASE_* unset when using PIN Test mode.

# --- Auth: Supabase email OTP (no Twilio) ---
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ…
# EXPO_PUBLIC_API_URL=https://YOUR_APP.vercel.app

# Optional: PIN allowlist instead of Supabase (no email either)
# EXPO_PUBLIC_AUTH_MODE=pin
# PIN_ALLOWLIST_JSON on Vercel — see docs/TESTING.md

# Force in-app mock API (optional; demo phone 0708060337 also uses mock)
# EXPO_PUBLIC_USE_MOCK_API=true

# --- Vercel project environment variables ---

# Neon Postgres (Prisma)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# PIN allowlist — JSON array on Vercel (share codes via WhatsApp, not SMS)
# Roles for Test demo: organizer, participant, outsider (privacy checks)
# PIN_ALLOWLIST_JSON=[{"phone":"+212600000001","pin":"******","userId":"user_d02_host"},{"phone":"+212600000002","pin":"******","userId":"user_d02_guest"},{"phone":"+212600000003","pin":"******","userId":"user_d02_outsider"}]

# JWT for API Bearer tokens (PIN mode). Generate: openssl rand -base64 32
AUTH_JWT_SECRET=your-random-secret

# Supabase JWT verification (only if using Supabase auth)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

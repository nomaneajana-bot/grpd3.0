# --- Mode sélection (mutuellement exclusifs dans l'esprit) ---
#
# 1) DEMO / jury offline (Casablanca seed, OTP 000000) — forces mock always:
EXPO_PUBLIC_DEMO_MODE=true
#
# 2) Explicit mock without demo seed world (optional; do not set with DEMO_MODE):
# EXPO_PUBLIC_USE_MOCK_API=true
#
# 3) Connected API — requires a real URL. Missing URL is an ERROR, not silent mock:
# EXPO_PUBLIC_DEMO_MODE=false
# EXPO_PUBLIC_USE_MOCK_API=false
# EXPO_PUBLIC_API_URL=https://YOUR_VERCEL_URL.vercel.app
#
# Leave API URL empty/unset only for demo or explicit mock modes.
# EXPO_PUBLIC_API_URL=
